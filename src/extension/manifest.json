{
  "manifest_version": 3,
  "name": "PixelPal",
  "version": "0.1.0",
  "description": "A low-poly AI companion that lives inside the browser.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PixelPal",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
